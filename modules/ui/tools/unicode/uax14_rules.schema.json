{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coral.invalid/schemas/uax14_rules.schema.json",
  "title": "Coral UAX #14 rule description",
  "description": "Boundary-anchored left/right token patterns for the generated UAX #14 DFA. This is not a general regex language: repeat groups have min=0 and no upper bound, and predicates are a closed vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["unicodeVersion", "rules"],
  "properties": {
    "unicodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "action", "left", "right"],
      "properties": {
        "id": { "type": "string", "pattern": "^LB[0-9]+[a-z]?$" },
        "priority": { "type": "integer", "minimum": 1 },
        "action": {
          "type": "string",
          "enum": ["no_break", "allow_break", "mandatory_break"]
        },
        "left": { "$ref": "#/$defs/sequence" },
        "right": { "$ref": "#/$defs/sequence" }
      }
    },
    "sequence": {
      "type": "array",
      "maxItems": 8,
      "items": { "oneOf": [{ "$ref": "#/$defs/predicate" }, { "$ref": "#/$defs/repeat" }] }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat"],
      "properties": {
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "items"],
          "properties": {
            "min": { "const": 0 },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/predicate" }
            }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{2}$" }
        },
        "notClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{2}$" }
        },
        "flagsAll": { "$ref": "#/$defs/flags" },
        "flagsNone": { "$ref": "#/$defs/flags" },
        "sot": { "const": true },
        "eot": { "const": true },
        "anyOf": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/predicate" }
        }
      },
      "oneOf": [
        { "required": ["sot"] },
        { "required": ["eot"] },
        { "required": ["anyOf"] },
        {
          "not": { "anyOf": [{ "required": ["sot"] }, { "required": ["eot"] }, { "required": ["anyOf"] }] },
          "anyOf": [
            { "required": ["classes"] },
            { "required": ["notClasses"] },
            { "required": ["flagsAll"] },
            { "required": ["flagsNone"] }
          ]
        }
      ]
    },
    "flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["pi", "pf", "ea", "epCn", "u25cc", "zwjTail"]
      }
    }
  }
}
